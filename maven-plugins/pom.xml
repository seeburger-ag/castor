<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
   <modelVersion>4.0.0</modelVersion>
   <artifactId>castor-maven-plugins</artifactId>
   
    <parent>
        <groupId>org.codehaus.castor</groupId>
        <artifactId>castor-parent</artifactId>
        <version>1.4.2-SNAPSHOT</version>
        <relativePath>../parent/pom.xml</relativePath>
    </parent>

   <packaging>maven-plugin</packaging>
   <name>Castor XML - Maven Mojos for executing XMLCTF tests</name>

   <!-- Valid here because of maven-plugin packaging: declares the minimum Maven version
        recorded in the generated plugin descriptor. Moved down from castor-parent, where
        it applied to non-plugin modules and triggered a Maven warning. -->
   <prerequisites>
      <maven>3.6.3</maven>
   </prerequisites>

   <build>
      <plugins>
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-plugin-plugin</artifactId>
            <configuration>
               <!-- The artifactId "castor-maven-plugins" (plural) matches neither
                    "maven-*-plugin" nor "*-maven-plugin", so the prefix cannot be
                    derived automatically and must be set explicitly.
                    Goals are invoked as e.g. castor:xmlctf-text. -->
               <goalPrefix>castor</goalPrefix>
            </configuration>
         </plugin>
      </plugins>
      <pluginManagement>
         <plugins>
         </plugins>
      </pluginManagement>
   </build>
   
   <dependencies>
      <dependency>
         <groupId>org.apache.maven</groupId>
         <artifactId>maven-plugin-api</artifactId>
      </dependency>
      <dependency>
         <groupId>org.apache.maven.plugin-tools</groupId>
         <artifactId>maven-plugin-annotations</artifactId>
         <scope>provided</scope>
      </dependency>
       
      <dependency>
         <groupId>org.apache.maven</groupId>
         <artifactId>maven-core</artifactId>
         <scope>provided</scope>
      </dependency>
      <dependency>
         <groupId>org.codehaus.castor</groupId>
         <artifactId>castor-testsuite-xml-framework</artifactId>
      </dependency>
      <dependency>
         <groupId>org.codehaus.castor</groupId>
         <artifactId>castor-xml</artifactId>
      </dependency>
      <dependency>
         <groupId>junit</groupId>
         <artifactId>junit</artifactId>
      </dependency>
      <dependency>
         <groupId>oro</groupId>
         <artifactId>oro</artifactId>
      </dependency>
      <dependency>
         <groupId>org.apache.velocity</groupId>
         <artifactId>velocity</artifactId>
      </dependency>
   </dependencies>

</project>
